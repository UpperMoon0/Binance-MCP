MCP_PUBLIC_URL=https://binance-mcp.example.com
MCP_OAUTH_OWNER_TOKEN=replace-with-at-least-32-url-safe-characters
MCP_OAUTH_STATE=/app/data/oauth-state.json
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_KEY_PATH=
BINANCE_PRIVATE_KEY_PASSPHRASE=
BINANCE_TRADING_ENABLED=false
BINANCE_RECV_WINDOW_MS=5000

BINANCE_LEDGER_PATH=/app/data/strategy.sqlite
BINANCE_STRATEGIES={}
# Optional default budget; unknown explicit IDs never fall back to this value.
BINANCE_DEFAULT_STRATEGY_ID=
BINANCE_APPROVED_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_MONITOR_INTERVAL_SECONDS=30

# External delivery is required by default. Explicit false allows local-only incidents.
# This does not disable incident persistence, execution pauses or recovery policy.
BINANCE_INCIDENT_RECEIVER_REQUIRED=true
# Separately approved idempotent HTTPS operator receiver. No automatic setup.
BINANCE_INCIDENT_WEBHOOK_URL=
BINANCE_INCIDENT_WEBHOOK_TOKEN=
